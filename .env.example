# Copie para .env.local (no seu PC) e cadastre as mesmas variáveis na Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# WhatsApp do brechó com DDI+DDD, só números (ex.: 5577999990000)
NEXT_PUBLIC_WHATSAPP=5577999990000

# Nome que aparece no topo do site
NEXT_PUBLIC_NOME_BRECHO=Brechó Solidário
